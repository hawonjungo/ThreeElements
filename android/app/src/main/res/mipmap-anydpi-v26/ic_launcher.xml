<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+: adaptive launcher icon (the launcher picks the shape). Layers made by art/make_injoker.py from the
     owner's app icon: the picture in the centre 72 dp, a blurred copy behind it. No monochrome layer: the picture
     is a full painted square, so a themed (single-colour) version of it would be a plain block. Android 7 uses the
     mipmap-*/ic_launcher.png tiles. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
