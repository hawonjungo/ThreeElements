<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 9+: draw into the camera cutout area ("short edges") from the very first frame. SDLActivity asks for
         the same mode later but only edits the window attributes without applying them, so on phones with a
         cutout the surface could start out shifted by the cutout's width. Declaring it in the theme makes the
         layout right from the start; the game letterboxes itself, so nothing important sits under the camera. -->
    <style name="AppTheme" parent="android:Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
